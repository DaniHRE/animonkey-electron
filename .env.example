# API pública do Anivexa. Vite expõe esta URL ao renderer, portanto nunca coloque tokens aqui.
VITE_ANIVEXA_API_URL=http://localhost:4000

# Habilite somente ao empacotar localmente para QA com API HTTP em localhost.
VITE_ALLOW_LOCAL_HTTP_API_FOR_TESTS=false

# Supabase Edge Function usado pelo processo principal para conta e sync.
# Esta chave publicável pode ser incluída no app; nunca use service_role aqui.
VITE_DESKTOP_API_URL=https://your-project-ref.supabase.co/functions/v1/desktop-api
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
