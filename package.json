{
  "name": "animonkey-electron",
  "productName": "Animonkey",
  "description": "Desktop anime discovery and personal library with offline tracking, optional account sync, and playback from available Anivexa sources",
  "author": "DaniHRE",
  "version": "1.0.0",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "husky",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "validate:release-notes": "node scripts/validate-release-notes.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "anime",
    "anilist",
    "anivexa",
    "desktop",
    "electron",
    "streaming"
  ],
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "yauzl": "3.3.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "electron": "43.4.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@vidstack/react": "1.15.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "dashjs": "^5.2.1",
    "electron-squirrel-startup": "^1.0.1",
    "hls.js": "^1.7.3",
    "lodash": "^4.18.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.11.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "packageManager": "pnpm@10.33.3"
}
